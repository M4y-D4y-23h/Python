casos = int(input())
for x in range(0, casos):
  n = []
  N = str(input())
  if N == "P=NP":
    print("skipped")
    continue
  for y in range(len(N)):
    if N[y] == '+':
      n.append(N[y].replace('+', ','))
    else:
      n.append(str(N[y]))
  n = ''.join(n)
  n = n.split(',')
  n = int(n[0]) + int(n[1])
  print(n)
